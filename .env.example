APP_NAME="Sitemap Generator"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sitemap_generator
DB_USERNAME=root
DB_PASSWORD=

# External Database (for Database Mode)
EXTERNAL_DB_HOST=
EXTERNAL_DB_PORT=3306
EXTERNAL_DB_DATABASE=
EXTERNAL_DB_USERNAME=
EXTERNAL_DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Sitemap Settings
SITEMAP_MAX_URLS=50000
SITEMAP_MAX_TOTAL=1000000
SITEMAP_CHUNK_SIZE=1000
SITEMAP_DEFAULT_CHANGEFREQ=weekly
SITEMAP_DEFAULT_PRIORITY=0.5

# Crawler Settings (disabled by default for shared hosting)
CRAWLER_ENABLED=false
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES=50000
CRAWLER_TIMEOUT=30
CRAWLER_DELAY=100

# CSV Settings
CSV_MAX_FILE_SIZE=52428800
